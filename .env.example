# Environment variables
PORT=5000
DEBUG=false
FLASK_ENV=production

# Google Gemini API Key (for NeMo Guardrails with Gemini)
GOOGLE_API_KEY=your_gemini_api_key_here

# Alternative: OpenAI API Key (if you want to use OpenAI instead)
# OPENAI_API_KEY=your-openai-api-key-here

# Logging level
LOG_LEVEL=INFO
